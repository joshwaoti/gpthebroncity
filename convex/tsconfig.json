{
    /* Standard Convex tsconfig.json */
    "compilerOptions": {
        "target": "esnext",
        "module": "esnext",
        "moduleResolution": "node",
        "allowJs": true,
        "checkJs": false,
        "strict": true,
        "isolatedModules": true,
        "noEmit": true,
        "skipLibCheck": true,
        "lib": [
            "esnext"
        ]
    },
    "include": [
        "**/*.ts"
    ]
}